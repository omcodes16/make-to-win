GROQ_API_KEY=your_groq_api_key_here

# Mappls (MapmyIndia) Geocoding & Village Search (Optional - falls back to OpenStreetMap Nominatim if omitted)
MAPPLS_API_KEY=your_mappls_api_key_or_rest_key
# Or OAuth2 credentials:
# MAPPLS_CLIENT_ID=your_mappls_client_id
# MAPPLS_CLIENT_SECRET=your_mappls_client_secret

# Bhashini (National Language Translation Mission - MeitY) NMT Translation (Optional - falls back to AI translation if omitted)
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_INFERENCE_KEY=your_bhashini_inference_api_key
